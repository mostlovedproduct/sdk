{
  "name": "@mostlovedproduct/mcp",
  "version": "0.1.0",
  "description": "Feedback tool for MCP servers: definition (plain JSON Schema), handler, optional official-SDK adapter.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "feedback",
    "submit_feedback",
    "agents",
    "most-loved-product"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Bearden Technologies Inc. (https://mostlovedproduct.com)",
  "homepage": "https://mostlovedproduct.com/docs/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mostlovedproduct/sdk.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/mostlovedproduct/sdk/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mostlovedproduct/core": "0.1.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "tsup": "^9.0.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
