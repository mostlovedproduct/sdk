{
  "name": "@mostlovedproduct/web",
  "version": "0.1.0",
  "description": "Web feedback widget for browsers, and a headless controller, from Most Loved Product.",
  "keywords": [
    "feedback",
    "widget",
    "web-component",
    "custom-element",
    "agents",
    "most-loved-product"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Bearden Technologies Inc. (https://mostlovedproduct.com)",
  "homepage": "https://mostlovedproduct.com/docs/web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mostlovedproduct/sdk.git",
    "directory": "packages/web"
  },
  "bugs": {
    "url": "https://github.com/mostlovedproduct/sdk/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./mlp.js": "./dist/mlp.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "size": "node scripts/size.mjs",
    "demo": "tsup && node scripts/demo.mjs"
  },
  "dependencies": {
    "@mostlovedproduct/core": "0.1.0"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "tsup": "^9.0.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
